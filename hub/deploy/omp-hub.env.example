# Copy to ~/.config/omp-hub/omp-hub.env and fill in real values.
# The process binds only the hub host's Tailnet IPv4 address (never 0.0.0.0);
# the boot-race this used to cause with tailscaled is fixed by systemd
# unit ordering (After=/Wants=tailscaled.service + an ExecStartPre that
# blocks on `tailscale ip -4`), not by widening the bind address.
OMP_HUB_PORT=4816
OMP_HUB_HOST=100.64.0.1
OMP_HUB_HOSTNAME=hub-host.your-tailnet.ts.net

# Shared secret checked against the `token` field of every AgentRegisterParams
# sent by the omp-connected extension over /ws/agent. Must match
# OMP_HUB_HOST_TOKEN in every interactive OMP session's own environment
# exactly, or registration is rejected and the socket is closed. Generate
# your own; do not reuse this placeholder.
OMP_HUB_HOST_TOKEN=<shared secret, generate-your-own>

OMP_HUB_TLS_CERT=/home/user/.config/omp-hub/certs/cert.pem
OMP_HUB_TLS_KEY=/home/user/.config/omp-hub/certs/key.pem