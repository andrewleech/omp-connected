# Copy to ~/.config/omp-hub/omp-hub-relay.env and fill in real values.
# The process binds only the hub host's Tailnet IPv4 address (never 0.0.0.0).
COLLAB_RELAY_HOST=100.64.0.1
COLLAB_RELAY_PORT=7466
COLLAB_RELAY_WEB_ROOT=/home/user/omp-hub/webui/collab
COLLAB_RELAY_TLS_CERT=/home/user/.config/omp-hub/certs/cert.pem
COLLAB_RELAY_TLS_KEY=/home/user/.config/omp-hub/certs/key.pem

# Browser Collab clients may originate from the relay's own deep-link UI
# (port 7466) or the omp-hub dashboard origin (port 4816, NOT claude-net's
# 4815 — using 4815 here was a live bug in the old claude-net env file).
COLLAB_RELAY_ALLOWED_ORIGINS=https://hub-host.your-tailnet.ts.net:7466,https://hub-host.your-tailnet.ts.net:4816