[Unit]
Description=Renew OMP Hub TLS certificate
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/bin/tailscale cert --min-validity=720h --cert-file=%h/.config/omp-hub/certs/cert.pem --key-file=%h/.config/omp-hub/certs/key.pem hub-host.your-tailnet.ts.net
ExecStartPost=/usr/bin/systemctl --user try-restart omp-hub.service
