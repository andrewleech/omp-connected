#!/usr/bin/env bun

import * as os from "node:os";

const hubUrl = process.env.OMP_HUB_URL;
if (!hubUrl) throw new Error("OMP_HUB_URL is required");

const hostToken = process.env.OMP_HUB_HOST_TOKEN;
if (!hostToken) throw new Error("OMP_HUB_HOST_TOKEN is required");

const hubWs = new URL(hubUrl);
hubWs.protocol = hubWs.protocol === "https:" ? "wss:" : "ws:";
hubWs.pathname = `${hubWs.pathname.replace(/\/$/, "")}/ws/host`;

// Deliberately not named OMP_BIN: this sidecar spawns that command as a
// child process, which -- if it happens to be bin/ompc -- inherits the
// environment and would read its own OMP_BIN as a self-referential
// native-binary override, looping forever instead of running OMP.
const ompCommand = process.env.OMP_COLLAB_BIN || "omp";
const hostId = `${os.userInfo().username}@${os.hostname()}`;
const ompVersion = "0.1.0";

interface JsonRpcRequest<M extends string = string, P = unknown> {
	jsonrpc: "2.0";
	id: string;
	method: M;
	params: P;
}
interface JsonRpcResult<R = unknown> {
	jsonrpc: "2.0";
	id: string;
	result: R;
}
interface JsonRpcError {
	jsonrpc: "2.0";
	id: string;
	error: { code: number; message: string };
}

function send(socket: WebSocket, frame: JsonRpcRequest | JsonRpcResult | JsonRpcError): void {
	if (socket.readyState === WebSocket.OPEN) socket.send(JSON.stringify(frame));
}

async function runOmp(args: string[]): Promise<{ stdout: string; error?: string }> {
	try {
		const proc = Bun.spawn([ompCommand, "collab", ...args], {
			stdin: "ignore",
			stdout: "pipe",
			stderr: "pipe",
		});
		const [stdout, stderr, exitCode] = await Promise.all([
			new Response(proc.stdout).text(),
			new Response(proc.stderr).text(),
			proc.exited,
		]);
		return exitCode === 0 ? { stdout } : { stdout, error: stderr.trim() || `omp exited ${exitCode}` };
	} catch (error) {
		return { stdout: "", error: error instanceof Error ? error.message : String(error) };
	}
}

function errorResult(id: string, message: string): JsonRpcError {
	return { jsonrpc: "2.0", id, error: { code: -32000, message } };
}

async function handle(socket: WebSocket, frame: JsonRpcRequest): Promise<void> {
	if (typeof frame.id !== "string") return;
	if (frame.method === "collab.list") {
		const result = await runOmp(["list", "--json"]);
		if (result.error) return send(socket, errorResult(frame.id, result.error));
		try {
			const output = JSON.parse(result.stdout) as { version?: unknown; hosts?: unknown };
			if (output.version !== 1 || !Array.isArray(output.hosts)) throw new Error("invalid omp collab list response");
			send(socket, { jsonrpc: "2.0", id: frame.id, result: { sessions: output.hosts } });
		} catch (error) {
			send(socket, errorResult(frame.id, error instanceof Error ? error.message : String(error)));
		}
		return;
	}
	if (frame.method !== "collab.link") return;
	const params = frame.params as Record<string, unknown>;
	if (
		typeof params?.instanceId !== "string" ||
		typeof params?.generation !== "number" ||
		(params?.access !== "view" && params?.access !== "control")
	)
		return send(socket, errorResult(frame.id, "invalid Collab link request"));
	const args = ["link", params.instanceId, "--json"];
	if (params.access === "view") args.push("--view");
	const result = await runOmp(args);
	if (result.error) return send(socket, errorResult(frame.id, result.error));
	try {
		const output = JSON.parse(result.stdout) as Record<string, unknown>;
		if (
			output.version !== 1 ||
			output.instanceId !== params.instanceId ||
			output.generation !== params.generation ||
			output.access !== params.access ||
			typeof output.url !== "string"
		)
			throw new Error("stale or invalid Collab link response");
		send(socket, {
			jsonrpc: "2.0",
			id: frame.id,
			result: { access: output.access, url: output.url, expiresAt: output.expiresAt },
		});
	} catch (error) {
		send(socket, errorResult(frame.id, error instanceof Error ? error.message : String(error)));
	}
}

function connect(): void {
	const socket = new WebSocket(hubWs);
	socket.addEventListener("open", () =>
		send(socket, {
			jsonrpc: "2.0",
			id: crypto.randomUUID(),
			method: "host.register",
			params: {
				hostId,
				user: os.userInfo().username,
				hostname: os.hostname(),
				ompVersion,
				token: hostToken,
			},
		}),
	);
	socket.addEventListener("message", (event) => {
		try {
			const frame = JSON.parse(String(event.data)) as Record<string, unknown>;
			if (frame.jsonrpc !== "2.0" || typeof frame.method !== "string" || typeof frame.id !== "string") return;
			void handle(socket, frame as unknown as JsonRpcRequest);
		} catch {
			// Ignore malformed hub frames.
		}
	});
	socket.addEventListener("close", () => setTimeout(connect, 1_000));
	socket.addEventListener("error", () => socket.close());
}

connect();