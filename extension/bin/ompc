#!/usr/bin/env bash
set -euo pipefail

usage() {
	echo "usage: ompc [-d | --detach] [session-suffix] [omp arguments...]" >&2
	exit 64
}

detach=false
case ${1:-} in
	-d|--detach) detach=true; shift ;;
esac

# CLI resolution: use the global `omp` binary from PATH by default (the
# official installer places it at ~/.local/bin/omp).  OMP_BIN overrides
# this for hosts with a non-standard install location.
if [[ -n ${OMP_BIN:-} ]]; then
	omp_command=("$OMP_BIN")
else
	omp_command=(omp)
fi

# The Collab CLI is not a session name, and automation -- in particular
# bin/omp-host, which invokes the configured OMP_COLLAB_BIN with
# `collab ...` -- must never attach a TUI.
if [[ ${1:-} == collab ]]; then
	exec "${omp_command[@]}" "$@"
fi

session_name=${PWD##*/}
if [[ ${1:-} != -* && -n ${1:-} ]]; then
	session_name+=".${1}"
	shift
fi

[[ $session_name =~ ^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$ ]] || usage

command -v tmux >/dev/null 2>&1 || {
	echo "ompc requires tmux; refusing to start an unprotected OMP session" >&2
	exit 69
}

tmux_config="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)/omp-tmux.conf"

# Each OMP session gets its own tmux server via -L for per-session process
# isolation (independent CPU/memory attribution in ps/top/htop, independent
# failure domains — one crashed server affects only its own session).

if "$detach"; then
	# Start detached — useful for agents spawning side-quest sessions.
	# If session already exists, just print the name.
	# Avoid `has-session -t` because dots in session names are parsed as
	# tmux's session.pane target separator; list-sessions is safe.
	if tmux -L "$session_name" list-sessions -F '#{session_name}' 2>/dev/null \
		| grep -qxF "$session_name"; then
		printf '%s\n' "$session_name"
		exit 0
	fi
	tmux -L "$session_name" -f "$tmux_config" new-session -d -s "$session_name" \
		"${omp_command[@]}" "$@"
	printf '%s\n' "$session_name"
	exit 0
fi

# Attach-or-create (interactive): -A attaches if session exists, creates
# otherwise — same pattern as `tmux new -A -s <name>`.
exec tmux -L "$session_name" -f "$tmux_config" new-session -A -s "$session_name" \
	"${omp_command[@]}" "$@"