#!/usr/bin/env bash
set -euo pipefail

usage() {
	echo "usage: ompc [-d | --detach] [session-suffix] [omp arguments...]" >&2
	exit 64
}

detach=false
case ${1:-} in
	-d|--detach) detach=true; shift ;;
esac

# Source hub connection env (OMP_HUB_URL, OMP_HUB_HOST_TOKEN) so the
# omp-connected extension can register with the hub.  The env file is
# managed by deploy; if absent, the extension runs without hub features.
OMP_HOST_ENV="${OMP_HOST_ENV:-${XDG_CONFIG_HOME:-$HOME/.config}/omp-connected/omp-host.env}"
if [[ -f "$OMP_HOST_ENV" ]]; then
	set -a
	# shellcheck source=/dev/null
	source "$OMP_HOST_ENV"
	set +a
fi

# CLI resolution: use the global `omp` binary from PATH by default (the
# official installer places it at ~/.local/bin/omp).  OMP_BIN overrides
# this for hosts with a non-standard install location.
if [[ -n ${OMP_BIN:-} ]]; then
	omp_command=("$OMP_BIN")
else
	omp_command=(omp)
fi

# The Collab CLI is not a session name, and automation (e.g. `ompc collab
# list --json`) must never attach a TUI.
if [[ ${1:-} == collab ]]; then
	exec "${omp_command[@]}" "$@"
fi

session_name=${PWD##*/}
has_suffix=false
if [[ ${1:-} != -* && -n ${1:-} ]]; then
	session_name+=".${1}"
	has_suffix=true
	shift
fi

[[ $session_name =~ ^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$ ]] || usage

command -v tmux >/dev/null 2>&1 || {
	echo "ompc requires tmux; refusing to start an unprotected OMP session" >&2
	exit 69
}

# Resolve through symlinks: install.sh links ompc into ~/.local/bin, and the
# bundled tmux config lives next to the real script, not the link.
tmux_config="$(dirname -- "$(readlink -f -- "${BASH_SOURCE[0]}")")/omp-tmux.conf"

# Each OMP session gets its own tmux server via -L for per-session process
# isolation (independent CPU/memory attribution in ps/top/htop, independent
# failure domains — one crashed server affects only its own session).
#
# OMPC_SESSION carries the tmux session name into OMP; the omp-connected
# extension registers it as the session's hub label.

# Dots in session names are tmux's session.pane target separator, so never
# pass the name as a target (`has-session -t`, `new-session -A` both break
# on `<dir>.<suffix>`); list-sessions output is compared literally instead.
session_live() {
	tmux -L "$1" list-sessions -F '#{session_name}' 2>/dev/null | grep -qxF "$1"
}

if "$detach"; then
	# Start detached — useful for agents spawning side-quest sessions.
	# If session already exists, just print the name.
	if session_live "$session_name"; then
		printf '%s\n' "$session_name"
		exit 0
	fi
	tmux -L "$session_name" -f "$tmux_config" new-session -d -s "$session_name" \
		-e "OMPC_SESSION=$session_name" "${omp_command[@]}" "$@"
	printf '%s\n' "$session_name"
	exit 0
fi

# Interactive picker: when other live ompc sessions extend this name — bare
# `ompc` matches `<dir>` and `<dir>.*`; `ompc foo` matches `<dir>.foo*` —
# choose one instead of silently attaching/creating the exact name. A lone
# exact match, no match, or a non-terminal keeps the direct behaviour below.
pick_session() {
	local sock_dir=${TMUX_TMPDIR:-/tmp}/tmux-$(id -u) sock name info
	local -a socks names=() labels=()
	local info_name info_attached info_activity
	local exact_live=false now i age
	shopt -s nullglob
	if "$has_suffix"; then
		socks=("$sock_dir/$session_name"*)
	else
		socks=("$sock_dir/$session_name" "$sock_dir/$session_name".*)
	fi
	shopt -u nullglob
	printf -v now '%(%s)T' -1
	for sock in "${socks[@]}"; do
		[[ -S $sock ]] || continue
		name=${sock##*/}
		[[ $name =~ ^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$ ]] || continue
		# One session per server; a stale socket (dead server) fails here.
		info=$(tmux -L "$name" list-sessions \
			-F '#{session_name} #{session_attached} #{session_activity}' 2>/dev/null) || continue
		read -r info_name info_attached info_activity <<<"$info"
		[[ $info_name == "$name" ]] || continue
		age=$((now - info_activity))
		if ((age < 60)); then age="${age}s"
		elif ((age < 3600)); then age="$((age / 60))m"
		elif ((age < 86400)); then age="$((age / 3600))h"
		else age="$((age / 86400))d"; fi
		[[ $name == "$session_name" ]] && exact_live=true
		names+=("$name")
		labels+=("$(printf '%-40s %s' "$name" "$( ((info_attached > 0)) && printf 'attached, ')active ${age} ago")")
	done
	# Nothing to choose between: exact-only or no live match.
	if ((${#names[@]} == 0)) || { ((${#names[@]} == 1)) && "$exact_live"; }; then
		return 0
	fi
	# Default (Enter) keeps the old behaviour: the exact name, new if not live.
	if ! "$exact_live"; then
		names=("$session_name" "${names[@]}")
		labels=("$(printf '%-40s %s' "$session_name" "(new session)")" "${labels[@]}")
	fi
	# Arrow-key menu (↑/↓ or k/j, Enter picks, q/Esc quits) drawn on stderr;
	# redraws in place by moving the cursor back up over the list.
	local -i sel=0 n=${#names[@]}
	local key rest
	printf 'ompc: sessions matching %s  (↑/↓ move, Enter select, q quit)\n' \
		"$session_name" >&2
	printf '\e[?25l' >&2
	trap 'printf "\e[?25h\n" >&2; exit 130' INT TERM
	while :; do
		for i in "${!labels[@]}"; do
			if ((i == sel)); then
				printf '\r\e[K\e[7m> %s\e[0m\n' "${labels[i]}" >&2
			else
				printf '\r\e[K  %s\n' "${labels[i]}" >&2
			fi
		done
		IFS= read -rsn1 key || key=q
		if [[ $key == $'\e' ]]; then
			rest=
			IFS= read -rsn2 -t 0.05 rest || true
			key+=$rest
		fi
		case $key in
			$'\e[A' | $'\eOA' | k) sel=$(((sel - 1 + n) % n)) ;;
			$'\e[B' | $'\eOB' | j) sel=$(((sel + 1) % n)) ;;
			'') break ;; # Enter
			q | Q | $'\e')
				printf '\e[?25h' >&2
				exit 0
				;;
		esac
		printf '\e[%dA' "$n" >&2
	done
	printf '\e[?25h' >&2
	trap - INT TERM
	session_name=${names[sel]}
}

if [[ -t 0 && -t 2 ]]; then
	pick_session
fi

# Attach-or-create. Each server holds exactly one session, so an untargeted
# attach-session reaches it without parsing the dotted name.
if session_live "$session_name"; then
	exec tmux -L "$session_name" attach-session
fi
exec tmux -L "$session_name" -f "$tmux_config" new-session -s "$session_name" \
	-e "OMPC_SESSION=$session_name" "${omp_command[@]}" "$@"