# Copy to ~/.config/omp-connected/omp-host.env and fill in real values.
#
# OMP_HUB_URL is the standalone omp-hub server's own origin (see
# https://github.com/andrewleech/omp-hub). This sidecar converts it to a
# wss:// (or ws://) connection to <OMP_HUB_URL>/ws/host.
OMP_HUB_URL=https://hub-host.your-tailnet.ts.net:4816

# Shared secret; must exactly match OMP_HUB_HOST_TOKEN configured on the
# omp-hub server, or host.register is rejected and the socket is closed.
OMP_HUB_HOST_TOKEN=<shared secret, must match the omp-hub server's own value>

# Optional: path or command used to invoke the `omp` CLI (this sidecar
# runs `<OMP_COLLAB_BIN> collab ...`, which bypasses Screen entirely).
# Defaults to `omp` resolved via PATH -- set this explicitly unless a
# real oh-my-pi `omp` is actually on PATH, since this plugin's own
# `bin/ompc` is deliberately not installed under that name. Deliberately
# not called OMP_BIN: this sidecar's child process inherits the
# environment, and if it were named OMP_BIN, ompc would read its own
# OMP_BIN back as a self-referential native-binary override and loop
# forever instead of running OMP.
OMP_COLLAB_BIN=/home/user/cc-pi-bridge/omp-workspace/marketplace/plugins/omp-connected/bin/ompc